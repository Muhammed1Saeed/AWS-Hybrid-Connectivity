########################################################
# Core 1 - Database (RDS MySQL in Spoke1 DB subnets)
# The master password is generated by AWS and stored in
# Secrets Manager (manage_master_user_password), so it never
# appears in the code or in the Git repo.
########################################################

############################
# DB Subnet Group (spoke1-DB-a + spoke1-DB-b)
############################
resource "aws_db_subnet_group" "spoke1" {
  name = "spoke1-db-subnet-group"
  subnet_ids = [
    aws_subnet.spoke1-DB-a.id,
    aws_subnet.spoke1-DB-b.id
  ]

  tags = {
    Name = "spoke1-db-subnet-group"
  }
}

############################
# RDS MySQL instance
############################
resource "aws_db_instance" "mysql" {
  identifier        = "spoke1-mysql"
  engine            = "mysql"
  engine_version    = "8.0"
  instance_class    = "db.t3.micro"
  allocated_storage = 20
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = "appdb"
  username = "admin"

  # Password generated by AWS and stored in Secrets Manager
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.spoke1.name
  vpc_security_group_ids = [aws_security_group.db.id]
  publicly_accessible    = false
  multi_az               = false

  backup_retention_period = 1
  skip_final_snapshot     = true
  deletion_protection     = false

  tags = {
    Name = "spoke1-mysql"
  }
}

############################
# Outputs
############################
output "rds_endpoint" {
  description = "RDS MySQL endpoint"
  value       = aws_db_instance.mysql.endpoint
}

output "rds_secret_arn" {
  description = "Secrets Manager ARN holding the RDS master password"
  value       = aws_db_instance.mysql.master_user_secret[0].secret_arn
}
